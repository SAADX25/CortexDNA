<Window x:Class="CortexDNA.CleanupResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cleanup Finished" Height="380" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="Button" x:Key="SuccessButtonStyle">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#28A745" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#34C759"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#28A745" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E7E34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" CornerRadius="15" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
            <!-- 1. Success Icon -->
            <Viewbox Height="64" Width="64" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Grid>
                    <Ellipse Fill="#28A745" Opacity="0.2"/>
                    <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z" 
                          Fill="#28A745" Stretch="Uniform" Margin="10"/>
                </Grid>
            </Viewbox>

            <!-- 2. Title -->
            <TextBlock Text="Cleanup Finished!" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <!-- 3. Hero Section -->
            <TextBlock x:Name="TxtFreedSpace" Text="289 KB" FontSize="48" FontWeight="ExtraBold" Foreground="#00ADEF" HorizontalAlignment="Center" Margin="0,10,0,10">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#00ADEF" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                </TextBlock.Effect>
            </TextBlock>
            
            <TextBlock Text="TOTAL JUNK FREED" FontSize="12" FontWeight="SemiBold" Foreground="#666" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- 4. Subtitle Details -->
            <TextBlock x:Name="TxtDetails" Text="Cleaned up 80 files..." FontSize="14" Foreground="#AAAAAA" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,25"/>

            <!-- 5. Footer Button -->
            <Button Content="Close" Width="200" Height="40" Click="BtnClose_Click" Style="{StaticResource SuccessButtonStyle}"/>
        </StackPanel>
    </Border>
</Window>