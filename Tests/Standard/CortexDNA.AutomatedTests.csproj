<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\CortexDNA.App\CortexDNA.App.csproj" />
    <ProjectReference Include="..\CortexDNA.Tests.csproj" ReferenceOutputAssembly="false" />
      <ProjectReference Include="../UiSmoke/CortexDNA.UiSmoke.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyRegressionHarness" AfterTargets="Build">
    <ItemGroup>
      <HarnessFiles Include="$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net10.0-windows\**\*" Exclude="$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net10.0-windows\fixtures-*\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(HarnessFiles)" DestinationFiles="@(HarnessFiles->'$(OutDir)RegressionHarness\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="CopyUiSmoke" AfterTargets="Build"><ItemGroup><UiSmokeFiles Include="$(MSBuildThisFileDirectory)..\UiSmoke\bin\$(Configuration)\net10.0-windows\**\*"/></ItemGroup><Copy SourceFiles="@(UiSmokeFiles)" DestinationFiles="@(UiSmokeFiles->'$(OutDir)UiSmoke\%(RecursiveDir)%(Filename)%(Extension)')"/></Target>
</Project>
