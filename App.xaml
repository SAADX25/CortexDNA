<Application x:Class="CortexDNA.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CortexDNA"
             xmlns:conv="clr-namespace:CortexDNA.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF050505"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF5F5F5"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF9CA3AF"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF6B7280"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF0E0E0E"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FF1F1F1F"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF121212"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF22C55E"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2622C55E"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF22C55E"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#FFF07178"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FFE8B84A"/>
        <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#FF1A1A1A"/>
        <SolidColorBrush x:Key="PressedBackgroundBrush" Color="#FF0A0A0A"/>
        <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#FF1F1F1F"/>
        <Color x:Key="AppBackgroundColor">#FF050505</Color>
        <Color x:Key="PrimaryTextColor">#FFF5F5F5</Color>
        <Color x:Key="SecondaryTextColor">#FF9CA3AF</Color>
        <Color x:Key="CardBackgroundColor">#FF0E0E0E</Color>
        <Color x:Key="CardBorderColor">#FF1F1F1F</Color>
        <Color x:Key="AccentColor">#FF22C55E</Color>
        <Color x:Key="AccentColor2">#FF15803D</Color>
        <Color x:Key="SuccessColor">#FF22C55E</Color>
        <Color x:Key="ErrorColor">#FFF07178</Color>
        <Color x:Key="WarningColor">#FFE8B84A</Color>

        <!-- Thin, arrow-less scrollbar used by every window -->
        <Style TargetType="Thumb" x:Key="ThinScrollThumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumb" Background="{DynamicResource CardBorderBrush}" CornerRadius="3" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="5" Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ThinScrollThumb}"/>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="5" Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ThinScrollThumb}"/>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="MinWidth" Value="5"/>
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="5"/>
                    <Setter Property="MinHeight" Value="5"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
