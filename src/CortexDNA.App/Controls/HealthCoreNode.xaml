<UserControl x:Class="CortexDNA.Controls.HealthCoreNode" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:h="clr-namespace:CortexDNA.Core.Health;assembly=CortexDNA.Core" xmlns:cv="clr-namespace:CortexDNA.Converters" Width="148" Height="106" ToolTip="{Binding Summary}" AutomationProperties.Name="{Binding Label}">
  <UserControl.Resources>
    <cv:HealthStateTextConverter x:Key="HealthStateText"/>
    <SolidColorBrush x:Key="OptimizationBrush" Color="#FF4D9DEB"/>
    <Style x:Key="NodeState" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource MutedTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static h:HealthState.Healthy}"><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static h:HealthState.Attention}"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static h:HealthState.OptimizationAvailable}"><Setter Property="BorderBrush" Value="{StaticResource OptimizationBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static h:HealthState.Error}"><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NodeSymbol" TargetType="Path">
      <Setter Property="Data" Value="M4,3 L24,3 L24,15 L4,15 Z M0,5 L4,5 M0,10 L4,10 M24,5 L28,5 M24,10 L28,10 M8,0 L8,3 M18,0 L18,3"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Node}" Value="{x:Static h:HealthNode.Gpu}"><Setter Property="Data" Value="M0,3 L28,3 L28,15 L0,15 Z M6,6 A3,3 0 1 1 6,12 A3,3 0 1 1 6,6 M20,6 A3,3 0 1 1 20,12 A3,3 0 1 1 20,6"/></DataTrigger>
        <DataTrigger Binding="{Binding Node}" Value="{x:Static h:HealthNode.Memory}"><Setter Property="Data" Value="M0,3 L28,3 L28,13 L0,13 Z M4,6 L9,6 L9,10 L4,10 Z M12,6 L17,6 L17,10 L12,10 Z M20,6 L25,6 L25,10 L20,10 Z M3,13 L3,17 M8,13 L8,17 M20,13 L20,17 M25,13 L25,17"/></DataTrigger>
        <DataTrigger Binding="{Binding Node}" Value="{x:Static h:HealthNode.Storage}"><Setter Property="Data" Value="M2,5 C2,0 26,0 26,5 C26,10 2,10 2,5 L2,13 C2,18 26,18 26,13 L26,5"/></DataTrigger>
        <DataTrigger Binding="{Binding Node}" Value="{x:Static h:HealthNode.Network}"><Setter Property="Data" Value="M0,5 Q14,-6 28,5 M5,10 Q14,2 23,10 M10,14 Q14,10 18,14 M13,17 L15,17"/></DataTrigger>
        <DataTrigger Binding="{Binding Node}" Value="{x:Static h:HealthNode.Startup}"><Setter Property="Data" Value="M4,12 L14,2 L24,12 M14,3 L14,18 M4,18 L24,18"/></DataTrigger>
        <DataTrigger Binding="{Binding Node}" Value="{x:Static h:HealthNode.Security}"><Setter Property="Data" Value="M14,1 L25,5 L23,13 L14,19 L5,13 L3,5 Z M9,9 L13,13 L20,6"/></DataTrigger>
        <DataTrigger Binding="{Binding Node}" Value="{x:Static h:HealthNode.Cleanup}"><Setter Property="Data" Value="M20,0 L10,10 M6,8 L17,13 L12,20 L0,14 Z M6,12 L3,16 M10,14 L7,18"/></DataTrigger>
        <DataTrigger Binding="{Binding Node}" Value="{x:Static h:HealthNode.Updates}"><Setter Property="Data" Value="M3,8 A10,7 0 0 1 23,5 L27,5 M27,0 L27,5 L22,5 M25,12 A10,7 0 0 1 5,15 L1,15 M1,20 L1,15 L6,15"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Path Data="M8,44 L72,10 L138,44 L74,78 Z" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="6" Margin="0,9,0,0"/>
    <Path x:Name="Glow" Data="M8,44 L72,10 L138,44 L74,78 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="8" Opacity="0"/>
    <Grid x:Name="Chip">
      <Path Data="M8,44 L72,10 L138,44 L74,78 Z" Fill="{DynamicResource AccentSoftBrush}" Stroke="{DynamicResource CardBorderBrush}"/>
      <Path Data="M20,45 L65,22 M28,50 L73,27 M37,54 L82,32 M46,59 L91,37 M55,64 L100,42" Stroke="{DynamicResource MutedTextBrush}" Opacity=".28" StrokeThickness="2"/>
      <Path Style="{StaticResource NodeSymbol}" Width="28" Height="17" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" VerticalAlignment="Top" Margin="0,2,0,0"/>
      <Border Style="{StaticResource NodeState}" CornerRadius="7" Width="100" Height="42" VerticalAlignment="Top" Margin="0,23,0,0">
        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="NoWrap"/>
      </Border>
    </Grid>
    <TextBlock Text="{Binding State,Converter={StaticResource HealthStateText}}" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="NoWrap"/>
  </Grid>
</UserControl>
