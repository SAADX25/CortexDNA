<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:CortexDNA.UI">
  <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource CortexButton}">
    <Setter Property="Padding" Value="12,11" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="NavPlate" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="SelectionMark" Background="{DynamicResource AccentBrush}" Opacity="0" CornerRadius="1" Margin="0,2,0,2" />
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="NavPlate" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="NavPlate" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
              <Setter TargetName="SelectionMark" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsSelected}" Value="True" />
                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ui:Motion.IsEnabled)}" Value="True" />
              </MultiDataTrigger.Conditions>
              <MultiDataTrigger.EnterActions>
                <BeginStoryboard x:Name="SelectionEnter">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SelectionMark" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" FillBehavior="Stop" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiDataTrigger.EnterActions>
              <MultiDataTrigger.ExitActions>
                <RemoveStoryboard BeginStoryboardName="SelectionEnter" />
              </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>