<UserControl x:Class="CortexDNA.Views.HealthReportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cv="clr-namespace:CortexDNA.Converters">
  <UserControl.Resources><cv:HealthStateTextConverter x:Key="HealthStateText"/></UserControl.Resources>
  <StackPanel Margin="0,16,0,0">
    <TextBlock Text="{Binding Result.Timestamp,StringFormat='Scan timestamp: {0:G}'}"/>
    <TextBlock Text="{Binding Result.HardwareTimestamp,StringFormat='Hardware observation: {0:G}'}"/>
    <TextBlock Text="{Binding Result.OsSummary,StringFormat='OS: {0}'}"/>
    <TextBlock Text="{Binding Result.HardwareSummary,StringFormat='Hardware: {0}'}"/>
    <TextBlock Text="{Binding Result.Score.Display,StringFormat='Assessed score: {0}'}" Style="{StaticResource TitleText}" Margin="0,8,0,0"/>
    <TextBlock Text="{Binding Result.Score.Coverage}" Margin="0,8,0,8"/>
    <TextBlock Text="Weights: Security 25 · Storage 20 · Startup 20 · Updates 15 · Maintenance 10 · Hardware 10" FontSize="12"/>
    <TextBlock Text="Unavailable areas are excluded from assessed points. Network is informational. A complete /100 score requires all weighted areas to be assessed." Margin="0,4,0,16"/>
    <ItemsControl ItemsSource="{Binding Areas}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding Node}" Style="{StaticResource TitleText}"/>
            <TextBlock Text="{Binding State,Converter={StaticResource HealthStateText},StringFormat='State: {0}'}"/>
            <TextBlock Text="{Binding Summary}"/>
            <TextBlock Text="{Binding Explanation}"/>
            <TextBlock Text="{Binding PointsDeducted,StringFormat='Points deducted: {0}'}"/>
            <TextBlock Text="{Binding Recommendation}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="Score deductions" Style="{StaticResource TitleText}" Margin="0,8,0,8"/>
    <ItemsControl ItemsSource="{Binding Result.Score.Deductions}">
      <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,10"><TextBlock Text="{Binding PointsDeducted,StringFormat='−{0} points'}"/><TextBlock Text="{Binding Area}"/><TextBlock Text="{Binding Severity,Converter={StaticResource HealthStateText}}"/><TextBlock Text="{Binding Reason}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="This report remains in memory. It contains no usernames, network addresses, startup commands, device serial numbers or personal file names." Style="{StaticResource CaptionText}"/>
  </StackPanel>
</UserControl>
