<UserControl x:Class="CortexDNA.Views.Pages.DiagnosticsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CortexDNA.Controls" Focusable="False">
  <StackPanel>
    <Border Style="{StaticResource CardStyle}">
      <StackPanel>
        <TextBlock Text="Current application state" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
        <TextBlock Text="{Binding Version, StringFormat=Version: {0}}" />
        <TextBlock Text="{Binding WindowsVersion}" Margin="0,8,0,0" />
        <TextBlock Text="{Binding Hardware.PrivilegeText}" Margin="0,8,0,0" />
        <TextBlock Text="{Binding Hardware.StatusMessage}" Margin="0,8,0,0" />
        <TextBlock Text="{Binding Shell.StartupVM.StatusMessage}" Margin="0,8,0,20" />
        <Button Content="Copy diagnostics" Command="{Binding Shell.CopyDiagnosticsCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="Local logs" Style="{StaticResource TitleText}" />
        <TextBlock Text="%LocalAppData% / CortexDNA / Logs" Margin="0,12,0,20" />
        <Button Content="Open log folder" Command="{Binding Shell.OpenLogsCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>