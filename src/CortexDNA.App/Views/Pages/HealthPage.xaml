<UserControl x:Class="CortexDNA.Views.Pages.HealthPage" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CortexDNA.Controls" xmlns:views="clr-namespace:CortexDNA.Views" xmlns:cv="clr-namespace:CortexDNA.Converters" Focusable="False">
  <UserControl.Resources>
    <cv:HealthStateTextConverter x:Key="HealthStateText"/>
    <!-- A determinate template with no theme-supplied continuous shimmer. -->
    <Style x:Key="HealthProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="PART_Track" ClipToBounds="True">
              <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <Border Style="{StaticResource CardStyle}">
      <StackPanel>
        <Grid>
          <StackPanel>
            <TextBlock Text="CORTEX HEALTH CORE" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Understand your system" Style="{StaticResource ValueText}" Margin="0,5,0,0"/>
            <TextBlock Text="Local observations. Clear explanations. You stay in control." Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel HorizontalAlignment="Right">
            <TextBlock x:Name="ScoreText" Text="{Binding Result.Score.Display,TargetNullValue='Not rated'}" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding Result.Score.Coverage}" Style="{StaticResource CaptionText}"/>
          </StackPanel>
        </Grid>
        <controls:CortexHealthCore x:Name="CoreScene" Margin="0,10,0,8"/>
        <TextBlock Text="Green · healthy    Yellow · attention    Blue · optimization    Red · confirmed problem    Gray · unavailable" FontSize="11" HorizontalAlignment="Center"/>
        <ProgressBar Style="{StaticResource HealthProgress}" Value="{Binding Progress,Mode=OneWay}" Margin="0,16,0,8" AutomationProperties.Name="Health scan progress"/>
        <DockPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Content="Scan health" Command="{Binding ScanCommand}" Margin="12,0,8,0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}"/>
          </StackPanel>
          <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
        </DockPanel>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="Health areas &amp; recommendations" Style="{StaticResource TitleText}" Margin="0,0,0,12"/>
        <ItemsControl ItemsSource="{Binding Areas}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding Node}" FontWeight="SemiBold"/><TextBlock Text="{Binding State,Converter={StaticResource HealthStateText}}" Style="{StaticResource CaptionText}"/></StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                  <TextBlock Text="{Binding Explanation}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding Recommendation}" Margin="0,5,0,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="No fixes run during assessment. Missing readings remain unavailable, and harmless suggestions are never labeled errors." Style="{StaticResource CaptionText}"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button Content="View hardware" Command="{Binding Shell.NavigateCommand}" CommandParameter="Hardware" Margin="0,0,8,0"/>
          <Button Content="View storage" Command="{Binding Shell.NavigateCommand}" CommandParameter="Storage"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
      <Expander Header="Detailed Health Report"><views:HealthReportView/></Expander>
    </Border>
  </StackPanel>
</UserControl>
