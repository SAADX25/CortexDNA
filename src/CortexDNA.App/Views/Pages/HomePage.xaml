<UserControl x:Class="CortexDNA.Views.Pages.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CortexDNA.Controls" Focusable="False">
  <StackPanel>
    <Border Style="{StaticResource CardStyle}" Padding="28">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="YOUR DEVICE" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="{Binding Hardware.ComputerName}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,12,0,6" />
          <TextBlock Text="{Binding Hardware.SystemInfo.OsName}" />
          <TextBlock Text="{Binding Hardware.StatusMessage}" Margin="0,16,0,0" Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
          <Button Content="Inside your system →" Command="{Binding Shell.NavigateCommand}" CommandParameter="Hardware" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,12" />
          <Button Content="Copy system specifications" Command="{Binding Hardware.CopyAllSpecsCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <UniformGrid Columns="3" Margin="0,16,0,16">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Processor" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
          <TextBlock Text="{Binding Hardware.CpuName}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Graphics" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
          <TextBlock Text="{Binding Hardware.GpuName}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="Memory" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
          <TextBlock Text="{Binding Hardware.SystemInfo.RamUsageText}" Style="{StaticResource ValueText}" />
          <ProgressBar Value="{Binding Hardware.SystemInfo.RamUsagePercent}" Margin="0,16,0,0" />
        </StackPanel>
      </Border>
    </UniformGrid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="A little maintenance, on your terms" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
          <TextBlock Text="Review cleanup before removing files, or choose which applications start with Windows." Margin="0,0,0,24" />
          <WrapPanel>
            <Button Content="Review cleanup" Command="{Binding Shell.NavigateCommand}" CommandParameter="Cleanup" Margin="0,0,12,0" />
            <Button Content="Review startup" Command="{Binding Shell.NavigateCommand}" CommandParameter="Startup" Margin="0,0,12,0" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}" Grid.Column="2">
        <StackPanel>
          <TextBlock Text="Network right now" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
          <TextBlock Text="DOWNLOAD" Style="{StaticResource CaptionText}" />
          <TextBlock Text="{Binding Hardware.SystemInfo.NetworkDownload}" Style="{StaticResource ValueText}" Margin="0,8,0,16" />
          <TextBlock Text="UPLOAD" Style="{StaticResource CaptionText}" />
          <TextBlock Text="{Binding Hardware.SystemInfo.NetworkUpload}" Style="{StaticResource ValueText}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </Grid>
    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="20" Margin="0,16,0,0">
      <Grid>
        <TextBlock Text="Local controls. Explicit changes. Your files stay on your PC." VerticalAlignment="Center" />
        <TextBlock Text="CORTEX / DNA" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>