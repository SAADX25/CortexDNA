<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CortexDNA</AssemblyName>
    <RootNamespace>CortexDNA</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    
    <!-- Metadata -->
    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <Authors>SAADX25</Authors>
    <Company>Cortex</Company>
    <Product>Cortex DNA</Product>

    <!-- Development Mode (SingleFile disabled for faster debugging) -->
    <!-- <PublishSingleFile>true</PublishSingleFile> -->
    <!-- <SelfContained>true</SelfContained> -->
    <!-- <RuntimeIdentifier>win-x64</RuntimeIdentifier> -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.2" />
    <ProjectReference Include="../CortexDNA.Cleanup/CortexDNA.Cleanup.csproj" />
    <ProjectReference Include="../CortexDNA.Core/CortexDNA.Core.csproj" />
    <ProjectReference Include="../CortexDNA.Hardware/CortexDNA.Hardware.csproj" />
    <ProjectReference Include="../CortexDNA.Infrastructure/CortexDNA.Infrastructure.csproj" />
    <ProjectReference Include="../CortexDNA.Optimization/CortexDNA.Optimization.csproj" />
    <ProjectReference Include="../CortexDNA.Startup/CortexDNA.Startup.csproj" />
    <ProjectReference Include="../CortexDNA.System/CortexDNA.System.csproj" />
  </ItemGroup>

</Project>
