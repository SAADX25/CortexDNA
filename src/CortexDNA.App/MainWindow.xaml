<Window x:Class="CortexDNA.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:CortexDNA.UI" Title="Cortex DNA" Height="840" Width="1320" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" PreviewKeyDown="Window_PreviewKeyDown" ui:Motion.IsEnabled="{Binding Appearance.MotionEnabled}">
  <Window.InputBindings>
    <KeyBinding Key="B" Modifiers="Control" Command="{Binding HardwareVM.BoostSystemCommand}" />
    <KeyBinding Key="L" Modifiers="Control" Command="{Binding HardwareVM.CleanDiskCommand}" />
    <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding HardwareVM.CopyAllSpecsCommand}" />
    <KeyBinding Key="F5" Command="{Binding HardwareVM.RefreshCommand}" />
  </Window.InputBindings>
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" />
  </WindowChrome.WindowChrome>
  <Border x:Name="RootChrome" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Margin="8" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
            <Border Width="28" Height="28" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Margin="0,0,10,0">
              <TextBlock Text="CX" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="CortexDNA" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
          </StackPanel>
          <Border Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
            <TextBlock Text="SYSTEM WORKSPACE" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="24,0" />
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="Theme" Command="{Binding ToggleThemeCommand}" Style="{StaticResource WindowControlButtonStyle}" AutomationProperties.Name="Toggle light and dark theme" />
            <Button Content="About" Click="OpenAbout_Click" Style="{StaticResource WindowControlButtonStyle}" />
            <Button Content="—" Click="BtnMinimize_Click" Style="{StaticResource WindowControlButtonStyle}" AutomationProperties.Name="Minimize to tray" />
            <Button Content="□" Click="BtnMaximize_Click" Style="{StaticResource WindowControlButtonStyle}" AutomationProperties.Name="Maximize or restore" />
            <Button Content="×" Click="BtnClose_Click" Style="{StaticResource CloseButtonStyle}" FontSize="20" AutomationProperties.Name="Close to tray" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="224" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
          <DockPanel Margin="12,18,12,12">
            <StackPanel DockPanel.Dock="Bottom" Margin="12,16,0,0">
              <TextBlock Text="LOCAL BY DESIGN" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="No account. No telemetry." FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="YOUR WORKSPACE" Style="{StaticResource CaptionText}" Margin="12,0,0,12" />
                <ItemsControl ItemsSource="{Binding NavigationItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource NavigationButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Label}" AutomationProperties.Name="{Binding Label}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Mark}" FontSize="10" Width="28" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Margin="32,26,32,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}" />
              <TextBlock Text="{Binding CurrentPage.Description}" Margin="0,8,0,0" MaxWidth="740" HorizontalAlignment="Left" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding HardwareVM.RefreshCommand}" VerticalAlignment="Top" Margin="16,0,0,0" AutomationProperties.Name="Refresh current hardware telemetry" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="32,0,24,24" Padding="0,0,8,0">
            <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch">
              <ContentControl.RenderTransform>
                <TranslateTransform />
              </ContentControl.RenderTransform>
            </ContentControl>
          </ScrollViewer>
          <Border Grid.Row="2" Visibility="{Binding Operations.IsRunning, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SurfaceBrush}" Padding="32,12">
            <StackPanel>
              <TextBlock Text="{Binding Operations.Message}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
              <ProgressBar Value="{Binding Operations.Progress, Mode=OneWay}" IsIndeterminate="{Binding Operations.IsIndeterminate}" Maximum="100" AutomationProperties.Name="Current operation progress" />
            </StackPanel>
          </Border>
          <Border Grid.Row="3" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SurfaceBrush}" Padding="32,12">
            <Grid>
              <TextBlock Text="{Binding HardwareVM.StatusMessage}" FontSize="11" MaxWidth="600" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding HardwareVM.PrivilegeText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <Border x:Name="NotificationPanel" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="5" Width="352" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,24,0" Padding="16" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <StackPanel>
              <Grid>
                <TextBlock Text="Notifications" Style="{StaticResource TitleText}" />
                <Button Content="×" Click="Notifications_Click" HorizontalAlignment="Right" Padding="6,0" AutomationProperties.Name="Close notifications" />
              </Grid>
              <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Notifications.Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Message}" Margin="0,0,12,0" Foreground="{Binding State, Converter={StaticResource UiStateBrush}}" AutomationProperties.LiveSetting="Polite" />
                          <Button Grid.Column="1" Content="×" Command="{Binding DataContext.Notifications.DismissCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,0" AutomationProperties.Name="Dismiss notification" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Text="No new notifications" Margin="0,12,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Notifications.Items.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Button Content="Close" Click="Notifications_Click" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
          <Button Grid.Row="3" Content="{Binding Notifications.Items.Count}" ContentStringFormat="Notifications · {0}" Click="Notifications_Click" HorizontalAlignment="Right" Margin="0,0,170,0" Padding="8,4" FontSize="11" AutomationProperties.Name="Show notifications" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>