<Application x:Class="CortexDNA.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:CortexDNA.Converters" xmlns:pvm="clr-namespace:CortexDNA.ViewModels.Pages" xmlns:pages="clr-namespace:CortexDNA.Views.Pages" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Colors.xaml" />
        <ResourceDictionary Source="Resources/Brushes.xaml" />
        <ResourceDictionary Source="Resources/Spacing.xaml" />
        <ResourceDictionary Source="Resources/Typography.xaml" />
        <ResourceDictionary Source="Resources/Animations.xaml" />
        <ResourceDictionary Source="Resources/Cards.xaml" />
        <ResourceDictionary Source="Resources/Buttons.xaml" />
        <ResourceDictionary Source="Resources/Navigation.xaml" />
        <ResourceDictionary Source="Resources/ToggleSwitch.xaml" />
        <ResourceDictionary Source="Resources/Dialogs.xaml" />
        <ResourceDictionary Source="Resources/Progress.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
      <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
      <conv:UiStateBrushConverter x:Key="UiStateBrush" />
      <conv:UsageToColorConverter x:Key="UsageToColor" />
      <conv:TempToColorConverter x:Key="TempToColor" />
      <DataTemplate DataType="{x:Type pvm:HomeViewModel}">
        <pages:HomePage />
      </DataTemplate>
      <DataTemplate DataType="{x:Type pvm:HealthViewModel}">
        <pages:HealthPage />
      </DataTemplate>
      <DataTemplate DataType="{x:Type pvm:CleanupViewModel}">
        <pages:CleanupPage />
      </DataTemplate>
      <DataTemplate DataType="{x:Type pvm:StorageViewModel}">
        <pages:StoragePage />
      </DataTemplate>
      <DataTemplate DataType="{x:Type pvm:StartupPageViewModel}">
        <pages:StartupPage />
      </DataTemplate>
      <DataTemplate DataType="{x:Type pvm:HardwarePageViewModel}">
        <pages:HardwarePage />
      </DataTemplate>
      <DataTemplate DataType="{x:Type pvm:GamingViewModel}">
        <pages:GamingPage />
      </DataTemplate>
      <DataTemplate DataType="{x:Type pvm:SecurityViewModel}">
        <pages:SecurityPage />
      </DataTemplate>
      <DataTemplate DataType="{x:Type pvm:ToolsViewModel}">
        <pages:ToolsPage />
      </DataTemplate>
      <DataTemplate DataType="{x:Type pvm:SettingsViewModel}">
        <pages:SettingsPage />
      </DataTemplate>
      <DataTemplate DataType="{x:Type pvm:DiagnosticsViewModel}">
        <pages:DiagnosticsPage />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>