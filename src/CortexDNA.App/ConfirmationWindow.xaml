<Window x:Class="CortexDNA.ConfirmationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" ShowInTaskbar="False">
  <Border Style="{StaticResource DialogCard}" Margin="16">
    <StackPanel>
      <TextBlock x:Name="Heading" Style="{StaticResource DialogTitle}" />
      <TextBlock x:Name="Explanation" Margin="0,16,0,24" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True" Margin="0,0,12,0" />
        <Button Content="Continue" Click="Confirm_Click" Style="{StaticResource PrimaryButtonStyle}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>