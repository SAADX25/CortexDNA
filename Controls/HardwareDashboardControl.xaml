<UserControl x:Class="CortexDNA.Controls.HardwareDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CortexDNA.Controls"
             xmlns:conv="clr-namespace:CortexDNA.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:UsageToColorConverter x:Key="UsageToColor"/>
        <conv:TempToColorConverter  x:Key="TempToColor"/>

        <Style x:Key="IconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconChipStyle" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <LinearGradientBrush x:Key="ButtonGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentColor}"  Offset="0.0"/>
            <GradientStop Color="{DynamicResource AccentColor2}" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="CopyChipStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CPU -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{DynamicResource IconChipStyle}">
                            <TextBlock Text="&#xE950;" Style="{DynamicResource IconStyle}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Processor" Style="{DynamicResource TitleText}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding CpuName}" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource CopyChipStyle}" Click="CopyCpuInfo_Click" ToolTip="Copy CPU name" Margin="6,0,0,0">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Button>
                                <TextBlock x:Name="TxtCpuCopyFeedback" Text="Copied" Foreground="{DynamicResource SuccessBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CpuList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Sensors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Value}" Grid.Column="1"
                                                           Style="{DynamicResource ValueText}" FontSize="18"
                                                           Foreground="{Binding Value, Converter={StaticResource TempToColor}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Memory -->
            <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{DynamicResource IconChipStyle}">
                            <TextBlock Text="&#xE8A9;" Style="{DynamicResource IconStyle}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Memory" Style="{DynamicResource TitleText}"/>
                            <TextBlock Text="{Binding SystemInfo.RamInfo}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ProgressBar Value="{Binding SystemInfo.RamUsagePercent}" Maximum="100" Height="6"
                                 Background="{DynamicResource CardBorderBrush}" BorderThickness="0"
                                 Foreground="{Binding SystemInfo.RamUsagePercent, Converter={StaticResource UsageToColor}}"/>

                    <TextBlock Text="{Binding SystemInfo.RamUsageText}" Style="{DynamicResource ValueText}" FontSize="20"
                               Foreground="{Binding SystemInfo.RamUsagePercent, Converter={StaticResource UsageToColor}}"
                               Margin="0,10,0,14"/>

                    <Button Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding BoostSystemCommand}"
                            IsEnabled="{Binding IsBoostEnabled}"
                            Background="{StaticResource ButtonGradientBrush}"
                            ToolTip="Trim unused RAM from background apps (Ctrl+B)"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" Foreground="White" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BoostButtonText}" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding CleanDiskCommand}"
                            IsEnabled="{Binding IsCleanDiskEnabled}"
                            ToolTip="Scan and remove junk files (Ctrl+L)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74C;" Foreground="{DynamicResource AccentBrush}" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CleanDiskButtonText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Network -->
            <Border Grid.Column="4" Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{DynamicResource IconChipStyle}">
                            <TextBlock Text="&#xE704;" Style="{DynamicResource IconStyle}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Network" Style="{DynamicResource TitleText}" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="DOWNLOAD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding SystemInfo.NetworkDownload}" Style="{DynamicResource ValueText}" FontSize="22" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource HoverBackgroundBrush}" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="UPLOAD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding SystemInfo.NetworkUpload}" Style="{DynamicResource ValueText}" FontSize="22" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{DynamicResource IconChipStyle}">
                                <TextBlock Text="&#xE7F8;" Style="{DynamicResource IconStyle}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Graphics" Style="{DynamicResource TitleText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding GpuName}" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource CopyChipStyle}" Click="CopyGpuInfo_Click" ToolTip="Copy GPU name" Margin="6,0,0,0">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Button>
                                    <TextBlock x:Name="TxtGpuCopyFeedback" Text="Copied" Foreground="{DynamicResource SuccessBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding GpuList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Sensors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <TextBlock Text="{Binding Value}" Grid.Column="1"
                                                               Style="{DynamicResource ValueText}" FontSize="18"
                                                               Foreground="{Binding Value, Converter={StaticResource TempToColor}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{DynamicResource IconChipStyle}">
                                <TextBlock Text="&#xE90F;" Style="{DynamicResource IconStyle}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Board &amp; BIOS" Style="{DynamicResource TitleText}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Board" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SystemInfo.MotherboardModel}" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" VerticalAlignment="Center" ToolTip="{Binding SystemInfo.MotherboardModel}"/>
                            <Button Grid.Column="2" Command="{Binding CopyMotherboardCommand}" Style="{StaticResource CopyChipStyle}" ToolTip="Copy model" Margin="0,0,0,10">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Button>

                            <TextBlock Grid.Row="1" Text="Version" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SystemInfo.BiosVersion}" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" VerticalAlignment="Center"/>
                            <Button Grid.Row="1" Grid.Column="2" Command="{Binding CopyBiosVersionCommand}" Style="{StaticResource CopyChipStyle}" ToolTip="Copy version" Margin="0,0,0,10">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Button>

                            <TextBlock Grid.Row="2" Text="Date" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SystemInfo.BiosDate}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Row="2" Grid.Column="2" Command="{Binding CopyBiosDateCommand}" Style="{StaticResource CopyChipStyle}" ToolTip="Copy date">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{DynamicResource IconChipStyle}">
                            <TextBlock Text="&#xEDA2;" Style="{DynamicResource IconStyle}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Storage" Style="{DynamicResource TitleText}" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding StorageList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding TotalSize}" HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid Height="8">
                                            <ProgressBar Value="{Binding UsagePercentage}" Maximum="100" BorderThickness="0"
                                                         Foreground="{Binding UsagePercentage, Converter={StaticResource UsageToColor}}">
                                                <ProgressBar.Template>
                                                    <ControlTemplate TargetType="ProgressBar">
                                                        <Grid x:Name="PART_Track">
                                                            <Border Background="{DynamicResource CardBorderBrush}" CornerRadius="4"/>
                                                            <Border x:Name="PART_Indicator"
                                                                    Background="{Binding UsagePercentage, Converter={StaticResource UsageToColor}}"
                                                                    CornerRadius="4" HorizontalAlignment="Left"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </ProgressBar.Template>
                                            </ProgressBar>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="{Binding UsageText}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding FreeSpace}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
