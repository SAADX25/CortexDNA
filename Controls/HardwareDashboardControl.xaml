<UserControl x:Class="CortexDNA.Controls.HardwareDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CortexDNA.Controls"
             xmlns:conv="clr-namespace:CortexDNA.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:UsageToColorConverter x:Key="UsageToColor"/>
        <conv:TempToColorConverter  x:Key="TempToColor"/>

        <!-- Gradient Accent Brush for progress bars -->
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00E5CC" Offset="0.0"/>
            <GradientStop Color="#00ADEF" Offset="0.5"/>
            <GradientStop Color="#7B61FF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Boost / Clean gradient -->
        <LinearGradientBrush x:Key="ButtonGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentColor}"  Offset="0.0"/>
            <GradientStop Color="{DynamicResource AccentColor2}" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Animated Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect x:Name="btnShadow" Color="{DynamicResource AccentColor}" Direction="270" ShadowDepth="4" BlurRadius="10" Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1.06" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1.06" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnShadow" Storyboard.TargetProperty="BlurRadius"
                                                             To="20" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="btnShadow" Storyboard.TargetProperty="Opacity"
                                                             To="0.75" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnShadow" Storyboard.TargetProperty="BlurRadius"
                                                             To="10" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="btnShadow" Storyboard.TargetProperty="Opacity"
                                                             To="0.45" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsBoosting}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0">
        <!-- ROW 1: Dynamic Stats (CPU, Memory, Network) -->
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- CPU Card -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="" Style="{DynamicResource IconStyle}"/>
                        <StackPanel>
                            <TextBlock Text="Processor (CPU)" Style="{DynamicResource TitleText}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CpuName}" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <Button Style="{DynamicResource WindowControlButtonStyle}" Click="CopyCpuInfo_Click" ToolTip="Copy CPU Name" Margin="5,0,0,0" Width="20" Height="20">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                </Button>
                                <TextBlock x:Name="TxtCpuCopyFeedback" Text="Copied!" Foreground="{DynamicResource SuccessBrush}" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding CpuList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10">
                                    <ItemsControl ItemsSource="{Binding Sensors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}"/>
                                                    <!-- Semantic color: temperature-aware for temp sensors, usage-aware otherwise -->
                                                    <TextBlock Text="{Binding Value}" Grid.Column="1"
                                                               Style="{DynamicResource ValueText}" FontSize="20"
                                                               Foreground="{Binding Value, Converter={StaticResource TempToColor}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Memory Card -->
            <Border Grid.Column="1" Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="" Style="{DynamicResource IconStyle}"/>
                        <TextBlock Text="Memory" Style="{DynamicResource TitleText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Semantic gradient progress bar -->
                    <Grid Margin="0,10">
                        <ProgressBar Value="{Binding SystemInfo.RamUsagePercent}" Maximum="100" Height="8"
                                     Background="{DynamicResource CardBorderBrush}" BorderThickness="0"
                                     Foreground="{Binding SystemInfo.RamUsagePercent, Converter={StaticResource UsageToColor}}"/>
                    </Grid>
                    
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,0,0,5" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SystemInfo.RamUsageText}" Style="{DynamicResource ValueText}"
                                   Foreground="{Binding SystemInfo.RamUsagePercent, Converter={StaticResource UsageToColor}}"
                                   HorizontalAlignment="Center"/>
                    </Viewbox>
                    <TextBlock Text="{Binding SystemInfo.RamInfo}" HorizontalAlignment="Center"/>
                    
                    <!-- Action Buttons - Vertical Stack with hover animation -->
                    <StackPanel Orientation="Vertical" Margin="0,15,0,0" HorizontalAlignment="Center">

                        <Button Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding BoostSystemCommand}"
                                IsEnabled="{Binding IsBoostEnabled}"
                                HorizontalAlignment="Center"
                                Width="160" Margin="0,0,0,8"
                                Background="{StaticResource ButtonGradientBrush}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE724;" Foreground="White" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BoostButtonText}" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding CleanDiskCommand}"
                                HorizontalAlignment="Center"
                                Width="160" Margin="0"
                                Background="{StaticResource ButtonGradientBrush}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE74C;" Foreground="White" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Foreground="White" FontSize="12" Text="{Binding CleanDiskButtonText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Network Card -->
            <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="" Style="{DynamicResource IconStyle}"/>
                        <TextBlock Text="Network" Style="{DynamicResource TitleText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,15,20" VerticalAlignment="Center" FontSize="18"/>
                        <StackPanel Grid.Column="1" Margin="0,0,0,20">
                            <TextBlock Text="Download" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding SystemInfo.NetworkDownload}" Style="{DynamicResource ValueText}"/>
                            </Viewbox>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,15,0" VerticalAlignment="Center" FontSize="18"/>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Upload" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding SystemInfo.NetworkUpload}" Style="{DynamicResource ValueText}"/>
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ROW 2: GPU, BIOS & Storage -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: GPU & BIOS -->
            <StackPanel Grid.Column="0" Margin="0,0,5,0">

                <!-- GPU Card -->
                <Border Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="" Style="{DynamicResource IconStyle}"/>
                            <StackPanel>
                                <TextBlock Text="Graphics (GPU)" Style="{DynamicResource TitleText}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding GpuName}" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <Button Style="{DynamicResource WindowControlButtonStyle}" Click="CopyGpuInfo_Click" ToolTip="Copy GPU Name" Margin="5,0,0,0" Width="20" Height="20">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                    </Button>
                                    <TextBlock x:Name="TxtGpuCopyFeedback" Text="Copied!" Foreground="{DynamicResource SuccessBrush}" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding GpuList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,10">
                                        <ItemsControl ItemsSource="{Binding Sensors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}"/>
                                                        <TextBlock Text="{Binding Value}" Grid.Column="1"
                                                                   Style="{DynamicResource ValueText}" FontSize="20"
                                                                   Foreground="{Binding Value, Converter={StaticResource TempToColor}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- BIOS & Motherboard Card -->
                <Border Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="" Style="{DynamicResource IconStyle}" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="BIOS &amp; Motherboard" Style="{DynamicResource TitleText}" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Text="Motherboard" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,15,8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SystemInfo.MotherboardModel}" Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" VerticalAlignment="Center" ToolTip="{Binding SystemInfo.MotherboardModel}"/>
                            <Button Grid.Column="2" Command="{Binding CopyMotherboardCommand}" Style="{DynamicResource WindowControlButtonStyle}" ToolTip="Copy Model" Margin="5,0,0,8" Width="20" Height="20">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                            </Button>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="BIOS Version" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,15,8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SystemInfo.BiosVersion}" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8" VerticalAlignment="Center"/>
                            <Button Grid.Row="1" Grid.Column="2" Command="{Binding CopyBiosVersionCommand}" Style="{DynamicResource WindowControlButtonStyle}" ToolTip="Copy Version" Margin="5,0,0,8" Width="20" Height="20">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                            </Button>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="BIOS Date" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SystemInfo.BiosDate}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Row="2" Grid.Column="2" Command="{Binding CopyBiosDateCommand}" Style="{DynamicResource WindowControlButtonStyle}" ToolTip="Copy Date" Margin="5,0,0,0" Width="20" Height="20">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Column: Storage -->
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <Border Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="" Style="{DynamicResource IconStyle}"/>
                            <TextBlock Text="Storage Drives" Style="{DynamicResource TitleText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding StorageList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,15" Padding="0,0,0,15">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" FontSize="16"/>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding TotalSize}" Grid.Column="2" Style="{DynamicResource ValueText}" FontSize="18"/>
                                            </Grid>
                                            <!-- Semantic color progress bar for storage -->
                                            <Grid Height="24">
                                                <ProgressBar Value="{Binding UsagePercentage}" Maximum="100" BorderThickness="0"
                                                             Foreground="{Binding UsagePercentage, Converter={StaticResource UsageToColor}}">
                                                    <ProgressBar.Template>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Grid x:Name="PART_Track">
                                                                <Border Background="{DynamicResource CardBorderBrush}" CornerRadius="12"/>
                                                                <Border x:Name="PART_Indicator"
                                                                        Background="{Binding UsagePercentage, Converter={StaticResource UsageToColor}}"
                                                                        CornerRadius="12" HorizontalAlignment="Left"/>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </ProgressBar.Template>
                                                </ProgressBar>
                                                <TextBlock Text="{Binding UsageText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="Bold"/>
                                            </Grid>
                                            <TextBlock Text="{Binding FreeSpace}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
