<UserControl x:Class="CortexDNA.Controls.StartupImpactControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <Style x:Key="MiniToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" CornerRadius="11" Background="{DynamicResource CardBorderBrush}">
                            <Ellipse x:Name="Thumb" Fill="White" Width="14" Height="14" Margin="4" HorizontalAlignment="Left">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="18"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostChipButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent" Margin="22,18,22,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="STARTUP IMPACT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock Text="Programs that launch with Windows" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,2"/>
                <TextBlock Text="{Binding BootSummary}" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource GhostChipButton}"
                    ToolTip="Reload from Windows so this list matches Task Manager">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource CardStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="PROGRAMS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding Items.Count}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="ENABLED" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding EnabledCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{DynamicResource CardStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="DISABLED" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding DisabledCount}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{DynamicResource CardStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="HIGH IMPACT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding HighImpactCount}" FontSize="22" FontWeight="SemiBold" Foreground="#F43F5E" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="8,12,8,12">
            <Grid>
                <TextBlock Text="{Binding DiagnosticsNote}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                           Margin="12,0,12,10" VerticalAlignment="Top" TextWrapping="Wrap"/>
                <ScrollViewer Margin="0,28,0,0" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="14,12" Margin="8,0,8,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border CornerRadius="9" Background="{DynamicResource CardBorderBrush}"
                                                    Visibility="{Binding HasIcon, Converter={StaticResource InvertBoolToVis}}">
                                                <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding Icon}" Width="32" Height="32"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <Border Margin="8,0,0,0" CornerRadius="6" Padding="6,1" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="This app is open now. That is not the same as startup enabled.">
                                                    <TextBlock Text="Open" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                            <Border CornerRadius="8" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#22000000"/>
                                                </Border.Background>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ImpactText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ImpactColor}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Button Content="Delay 30s" Style="{StaticResource GhostChipButton}"
                                                    Command="{Binding DelayCommand}"
                                                    ToolTip="Start this app 30 seconds after you sign in"
                                                    Visibility="{Binding ShowDelayButton, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="Remove delay" Style="{StaticResource GhostChipButton}"
                                                    Command="{Binding RemoveDelayCommand}"
                                                    Visibility="{Binding IsDelayed, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <ToggleButton Grid.Column="3" Style="{StaticResource MiniToggle}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Enable or disable at startup"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="Reading startup programs…"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="No startup programs found."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
