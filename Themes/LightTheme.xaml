<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Soft Slate Theme — warm blue-gray, easy on the eyes -->
  <Color x:Key="AppBackgroundColor">#FFE8ECF2</Color>  <!-- Warm blue-gray bg — not white -->
  <Color x:Key="PrimaryTextColor">#FF1E293B</Color>    <!-- Slate 800 — dark but not black -->
  <Color x:Key="SecondaryTextColor">#FF64748B</Color>  <!-- Slate 500 -->
  <Color x:Key="CardBackgroundColor">#FFF1F4F9</Color> <!-- Off-white cards — no glare -->
  <Color x:Key="CardBorderColor">#FFD1D9E6</Color>     <!-- Soft blue-gray border -->
  <Color x:Key="AccentColor">#FF3B82F6</Color>         <!-- Blue-500 — vibrant but calm -->

</ResourceDictionary>